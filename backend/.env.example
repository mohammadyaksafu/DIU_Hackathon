# ---- Storage ----
# Empty = SQLite file in ./data. Postgres example: postgresql://user:password@host:5432/shurokkha
DATABASE_URL=
# Optional Redis for caching (in-memory fallback when empty or unreachable)
REDIS_URL=

# ---- GenAI (optional; without a key the copilot uses deterministic templates) ----
# auto | anthropic | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=<your-anthropic-api-key>
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=30

# ---- Security ----
JWT_SECRET=<random-32-byte-string>
DEMO_PASSWORD=<choose-a-demo-password>
AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=1200

# ---- Model / runtime ----
ACTIVE_MODEL=
SEED_ON_BOOT=true
AUTO_BOOTSTRAP=true
LATENCY_BUDGET_MS=150
GRAPH_REFRESH_SECONDS=600
